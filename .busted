return {
    _all = {
        verbose = true,
        ROOT = { "spec" },
        -- Before any spec: the cds modules behind proxies that allow only
        -- what truth-table.needs declares.
        helper = "spec/strict.lua",
        -- Resolve require("truth-table.core") against this project's lua/ tree,
        -- and require("cds.fp") against the house library's checkout beside
        -- this one, the same source lazy.lua pins for the editor.
        lpath = "./lua/?.lua;./lua/?/init.lua;../cds-lua-fp/lua/?.lua;../cds-lua-fp/lua/?/init.lua",
    },
    -- The pure specs, under plain Lua: no `vim` global to lean on.
    default = {
        pattern = "_spec",
        ["exclude-pattern"] = "_nvim_spec",
    },
    -- The editor specs, inside Neovim: `busted --run=nvim --lua=nlua`.
    nvim = {
        pattern = "_nvim_spec",
    },
}
